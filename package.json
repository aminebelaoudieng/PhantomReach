{
  "name": "phantom-reach",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "license": "AGPL-3.0-only",
  "bin": {
    "phantom-reach-mcp": "./dist/mcp/server.js"
  },
  "scripts": {
    "dev": "next dev",
    "local": "node scripts/local-dev.mjs",
    "local:preflight": "node scripts/local-preflight.mjs",
    "build": "next build",
    "build:mcp": "tsc -p tsconfig.mcp.json",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:visual": "node testing_framework/visual-smoke.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "test:watch": "vitest --watch",
    "test:verbose": "vitest run --reporter=verbose",
    "verify:grow-report": "vitest run testing_framework/test-suites/grow-commercial.test.ts testing_framework/test-suites/grow-pdf.test.ts",
    "prebuild": "npm run verify:grow-report"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@google/genai": "^2.10.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@react-pdf/renderer": "^4.3.2",
    "@supabase/supabase-js": "2.119.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.27",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "docx": "^9.6.0",
    "exceljs": "^4.4.0",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "openai": "^6.25.0",
    "postcss": "8.5.33",
    "pptxgenjs": "^4.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.13",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@hono/node-server": "2.1.11",
    "express-rate-limit": "8.7.5",
    "hono": "4.13.19",
    "image-size": "2.1.0",
    "uuid": "11.1.1"
  }
}
