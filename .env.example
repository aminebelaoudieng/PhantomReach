# ===========================================
# Phantom Reach - Environment Variables
# ===========================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Core data sources
GOOGLE_PLACES_API_KEY=
GOOGLE_PAGESPEED_API_KEY=
GOOGLE_CRUX_API_KEY=

# Optional enrichment sources
CENSUS_API_KEY=
OPENCORPORATES_API_TOKEN=
YELP_API_KEY=

# Optional AI providers
LLM_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=

# Optional hosted mode (Vercel + Supabase)
# Keep these server-side. Do not prefix secrets with NEXT_PUBLIC_.
PHANTOM_DB_BACKEND=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
PHANTOM_DB_ACCESS_TOKEN=
APP_ACCESS_USERNAME=
APP_ACCESS_PASSWORD=

# Grow audit (server-only; restrict spending in SerpKite dashboard too)
SERPKITE_API_KEY=
GROW_COUNTRY=ca
GROW_GRID_SIZE=5
GROW_MAX_SERPKITE_CREDITS=45
GROW_AI_VISIBILITY=on

# Optional default offer price and booking CTA for newly created audits
GROW_OFFER_MONTHLY_CAD=
GROW_BOOKING_URL=

# Optional real OSM road basemap; set off to disable public Overpass requests
GROW_OSM_MAP=on

# Optional one-call Gemini commentary enrichment for Grow audits. Existing GOOGLE_AI_API_KEY or GEMINI_API_KEY is used.
GROW_GEMINI_NARRATIVE=on
GROW_GEMINI_MODEL=gemini-3.1-flash-lite
